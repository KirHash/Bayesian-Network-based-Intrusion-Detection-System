# Copy to ".env" next to docker-compose.yml. Never commit ".env".

# The name people will open. It must point at this machine (an A record, or a DuckDNS name
# set to this server's public IP) and ports 80 and 443 must reach it, so Caddy can get a
# Let's Encrypt certificate. "localhost" tries the stack on your own computer instead.
IDS_DOMAIN=ids.example.com

# Pages hosted elsewhere (Netlify) that may call this server, comma separated, no "*".
# Build those pages with VITE_API_URL=https://<IDS_DOMAIN>.
# IDS_CORS_ORIGINS=https://your-site.netlify.app

# Optional. Accounts are the normal way in (docker compose run --rm ids python manage_users.py add NAME --role admin).
# IDS_ADMIN_TOKEN=
# IDS_API_KEY=
# Key for the secrets saved in the database; otherwise a key file is made in the data volume.
# IDS_SECRET_KEY=

# Largest upload, in MB, and the proxy's matching limit.
# IDS_MAX_UPLOAD_MB=4096
# IDS_UPLOAD_LIMIT=4GB

# Host ports, only if 80 / 443 are taken (public Let's Encrypt needs the standard ones).
# IDS_HTTP_PORT=80
# IDS_HTTPS_PORT=443

# The private network the two containers share. Change it only if it clashes with a network
# this server already uses (the dashboard believes X-Forwarded-For from this range only).
# IDS_SUBNET=172.29.77.0/24
