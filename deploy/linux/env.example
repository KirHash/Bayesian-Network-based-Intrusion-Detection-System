# /etc/bayesian-ids/env   (chmod 600, owned by root)
# systemd reads KEY=value lines; no quotes, no "export".

# Arguments for serve.py. With a reverse proxy in front (recommended):
IDS_SERVE_ARGS=--host 127.0.0.1 --port 8000 --behind-proxy
# Direct HTTPS with your own certificate instead:
# IDS_SERVE_ARGS=--host 0.0.0.0 --port 8443 --cert /etc/bayesian-ids/tls.crt --key /etc/bayesian-ids/tls.key

IDS_DB=/var/lib/bayesian-ids/ids.db
IDS_DATA_DIR=/var/lib/bayesian-ids/captures

# Accounts are created with:
#   sudo -u ids env $(cat /etc/bayesian-ids/env | xargs) /opt/bayesian-ids/venv/bin/python /opt/bayesian-ids/manage_users.py add alice --role admin
# Optional shared admin credential for emergencies:
# IDS_ADMIN_TOKEN=a-long-random-string
# IDS_API_KEY=another-long-random-string
# IDS_SMTP_PASSWORD=
