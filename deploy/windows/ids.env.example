# Copy to ids.env (same folder). One KEY=value per line; # starts a comment.
# Loaded by run-server.ps1 each time the server starts.

# Where alerts, users and settings are stored (back this file up)
IDS_DB=C:\ProgramData\BayesianIDS\ids.db

# Pcap / CSV files the dashboard's Capture panel may open
IDS_DATA_DIR=C:\ProgramData\BayesianIDS\captures

# Optional: a shared admin credential for emergencies. Accounts
# (python manage_users.py add NAME --role admin) are the normal way in.
# IDS_ADMIN_TOKEN=a-long-random-string

# Optional: fixed API key for flow exporters (otherwise create one in the dashboard)
# IDS_API_KEY=another-long-random-string

# Email notifications read their password from here
# IDS_SMTP_PASSWORD=
