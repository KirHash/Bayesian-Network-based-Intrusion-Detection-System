# Copy to ".env" (same folder as serve.py) and edit. serve.py reads it at start.
# Real environment variables override this file. NEVER commit ".env".
# Lines are KEY=value, no "export". Leave a line commented out to use the default.

# -- where things live ---------------------------------------------------------
# IDS_DB=ids.db
# IDS_DATA_DIR=captures
# IDS_DATASET_DIR=dataset
# IDS_MODEL=bayesian_ids.pkl
# IDS_CERT_DIR=certs
# IDS_MAX_UPLOAD_MB=4096

# -- sign-in ----------------------------------------------------------------------
# Accounts are better (python manage_users.py add alice --role admin); a shared token is a fallback.
# IDS_ADMIN_TOKEN=change-me-to-a-long-random-string
# Key for flow submissions to /api/score (can also be created in the dashboard).
# IDS_API_KEY=change-me-to-another-long-random-string
# Encrypts stored notification secrets; generated into <db>.key if absent.
# IDS_SECRET_KEY=

# -- dashboard on a separate site (Netlify) ----------------------------------------
# Sites allowed to call the API from a browser, comma separated, no "*".
# IDS_CORS_ORIGINS=https://your-site.netlify.app

# -- reverse proxy (Operations -> HTTPS proxy, or proxy/Caddyfile) -----------------
# IDS_PROXY_ADDRESS=ids.example.com
# IDS_UPSTREAM=127.0.0.1:8000
# IDS_UPLOAD_LIMIT=4GB
# IDS_TLS=internal

# -- notifications -------------------------------------------------------------------
# Settings are normally entered in the dashboard (Operations -> Notifications), which stores them encrypted.
# IDS_NOTIFY_CONFIG=notify.json

# -- frontend build only (not read by Python; set in Netlify or before "npm run build") --
# VITE_API_URL=https://your-backend.example.com

# -- go_online.py / "Start Bayesian IDS (Online).bat" ---------------------------------------
# Your Netlify address. The launcher allows it to call the server and opens it with the
# tunnel address filled in, so the pages never need rebuilding when the address changes.
# IDS_SITE_URL=https://your-site.netlify.app

# -- push notifications --------------------------------------------------------------------
# The contact the push services see in the server's signed identity (a mailto: or https: address).
# IDS_PUSH_SUBJECT=mailto:you@example.org

# -- backups ---------------------------------------------------------------------------------
# Where the daily automatic backups go (default: a backups/ folder beside the database) and how many
# automatic ones to keep.
# IDS_BACKUP_DIR=/data/backups
# IDS_BACKUP_KEEP=7
